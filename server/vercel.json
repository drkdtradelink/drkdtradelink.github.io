{
  "version": 2,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/health", "destination": "/api/index.js" },
    { "source": "/api/health", "destination": "/api/index.js" },
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/(.*)", "destination": "/api/index.js" }
  ]
}
