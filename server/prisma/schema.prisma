datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Company {
  id             String   @id @default(uuid())
  legalName      String
  displayName    String
  address        String
  city           String
  state          String
  country        String   @default("India")
  postalCode     String?
  phone          String?
  email          String?
  gstin          String?
  iec            String?
  warehouseCode  String?
  bankName       String?
  bankAccount    String?
  bankIfsc       String?
  bankBranch     String?
  customStation  String?
  subdomain      String   @unique // e.g. "drkd", "companya"
  status         String   @default("active") // active | inactive
  letterheadBase64 String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  users          User[]
  parties        Party[]
  stockItems     StockItem[]
  dutyRules      DutyRule[]
  grTransactions GRTransaction[]
  auditLogs      AuditLog[]
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  phone         String?
  passwordHash  String
  companyId     String?  // null means super admin (not bound to a single company)
  role          String   @default("operator") // admin (super admin/company admin) | manager | operator
  status        String   @default("active") // active | inactive | suspended
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company       Company? @relation(fields: [companyId], references: [id])
  grTransactions GRTransaction[]
  auditLogs     AuditLog[]
}

model Party {
  id            String   @id @default(uuid())
  companyId     String
  name          String
  address       String
  city          String
  state         String
  gstin         String?
  warehouseCode String?
  phone         String?
  email         String?
  status        String   @default("active") // active | inactive
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company       Company  @relation(fields: [companyId], references: [id])
  grTransactions GRTransaction[]
}

model StockItem {
  id                String   @id @default(uuid())
  companyId         String
  commodityName     String
  commodityType     String   // Beer | Alcohol/Wine
  beDetails         String   // Bill of Entry details
  bondDetails       String   // Bond details
  bondExpiryDate    DateTime?
  pricePerCaseUSD   Float
  totalQuantity     Int
  remainingQuantity Int
  packing           String
  unit              String   @default("Cases")
  dutyPercentage    Float
  presentDutyBalance Float    @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company           Company  @relation(fields: [companyId], references: [id])
  grItems           GRTransactionItem[]
}

model DutyRule {
  id             String   @id @default(uuid())
  companyId      String
  name           String
  commodityType  String   // Beer | Alcohol/Wine
  dutyPercentage Float
  status         String   @default("active") // active | inactive
  effectiveFrom  DateTime @default(now())
  effectiveTo    DateTime?
  version        Int      @default(1)
  formula        String?  @default("assessableValueInr * (dutyPercentage / 100)")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company        Company  @relation(fields: [companyId], references: [id])
}

model GRTransaction {
  id                  String   @id @default(uuid())
  grNumber            String   @unique
  companyId           String
  userId              String
  partyId             String
  date                DateTime
  invoiceDate         DateTime?
  dcDate              DateTime?
  exchangeRate        Float
  invoiceNumber       String
  dcNumber            String
  presentDutyBalance  Float
  status              String   @default("draft") // draft | generated | printed | cancelled
  calculationSnapshot String   // JSON stringified snapshot
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  generatedAt         DateTime?

  company             Company  @relation(fields: [companyId], references: [id])
  user                User     @relation(fields: [userId], references: [id])
  party               Party    @relation(fields: [partyId], references: [id])
  items               GRTransactionItem[]
}

model GRTransactionItem {
  id                 String   @id @default(uuid())
  transactionId      String
  stockItemId        String
  item               String
  commodityType      String
  qty                Int
  packing            String
  unit               String   @default("Cases")
  pricePerCaseUSD    Float
  beDetails          String
  bondDetails        String
  balanceInBond      String
  usdValue           Float
  assessableValueInr Float
  dutyPercentage     Float
  dutyAmountInr      Float
  dutyRuleId         String?
  dutyRuleSnapshot   String?  // JSON stringified snapshot of the duty rule used

  transaction        GRTransaction @relation(fields: [transactionId], references: [id])
  stockItem          StockItem     @relation(fields: [stockItemId], references: [id])
}

model AuditLog {
  id          String   @id @default(uuid())
  companyId   String?
  userId      String
  userName    String
  userRole    String
  entityType  String   // "Party" | "StockItem"
  entityId    String
  entityName  String?
  action      String   // "UPDATE"
  changes     String   // JSON stringified array of diffs: [ { field, oldVal, newVal } ]
  createdAt   DateTime @default(now())

  company     Company? @relation(fields: [companyId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
}
